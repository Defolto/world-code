# Настройки деплоя на NetAngels (npm run deploy).
# Скопируй в .env.deploy и заполни — тот файл в .gitignore, секреты не коммитятся.

# API-ключ из панели NetAngels (раздел «API-ключ»)
NETANGELS_API_KEY=

# id сайта в панели; узнать: npm run deploy -- --list-sites
NETANGELS_SITE_ID=

# SSH-доступ к контейнеру хостинга (включается в панели), формат user@host
DEPLOY_SSH=

# Путь к корню сайта на сервере. Деплой заменяет в нём backend/ и static/,
# всё остальное (.venv, .env, data/) не трогает
DEPLOY_DIR=

# Необязательно: чем создавать venv на сервере, если python3 указывает не туда
REMOTE_PYTHON=python3
